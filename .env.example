# Copy this file to .env before starting the stack.
GITLAB_VERSION=19.2.1-ce.0
GITLAB_HOSTNAME=apps.localmac.net
GITLAB_BIND_ADDRESS=127.0.0.1
GITLAB_HTTPS_PORT=8445
GITLAB_SSH_PORT=2222
GITLAB_TIMEZONE=Asia/Shanghai

# Keep the runner independently upgradeable from the GitLab server.
GITLAB_RUNNER_VERSION=alpine-v19.2.1

# Rotate Docker stdout/stderr logs independently of GitLab's internal logrotate.
DOCKER_LOG_MAX_SIZE=50m
DOCKER_LOG_MAX_FILES=5
